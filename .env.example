# OpenAI: embeddings (text-embedding-3-small) and query-to-filter parsing (gpt-4o-mini)
OPENAI_API_KEY=

# Qdrant: host only; the client adds ports 6333 (HTTP) and 6334 (gRPC)
QDRANT_URL=localhost
QDRANT_API_KEY=
QDRANT_UI_API_KEY=

# MongoDB with the people collection (people_db.people)
MONGO_URI=mongodb://localhost:27017
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
